            draw_grouped_metric(d, "correct.pODC", "Correct target-dose selection (%)", 
                y_max = max_correct)
        })
        output$sample_size_plot <- renderPlot({
            d <- overview_matrix_data()
            draw_grouped_metric(d, "mean.npat", "Mean sample size", 
