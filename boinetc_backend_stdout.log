            config_label <- paste0("Max cohorts=", as.integer(round(x$totaln/x$cohortsize)), 
                " | Max N=", x$totaln, " | Cohort size=", x$cohortsize, 
                " | Early stop=", x$n.earlystop, " | Set=", x$parameter_set, 
