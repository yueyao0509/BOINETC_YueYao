        output$target_alloc_matrix_plot <- renderPlot({
            draw_summary_heatmap(overview_matrix_data(), "target.PPTS", 
                "Target Patient Allocation (%)", digits = 1, 
                scale_max = 100)
        })
        output$correct_selection_plot <- renderPlot({
            d <- overview_matrix_data()
